TENSOR_LIB_DIR := tensor_lib
TENSOR_LIB_BUILD_DIR := $(TENSOR_LIB_DIR)/build
TENSOR_LIB_HOST_OBJ_DIR := $(TENSOR_LIB_BUILD_DIR)/host
TENSOR_LIB_RV_OBJ_DIR := $(TENSOR_LIB_BUILD_DIR)/rv
TENSOR_LIB_HOST_STATIC_OBJ_DIR := $(TENSOR_LIB_BUILD_DIR)/host_static
TENSOR_LIB_RV_STATIC_OBJ_DIR := $(TENSOR_LIB_BUILD_DIR)/rv_static

TENSOR_LIB_SOURCES := \
	$(TENSOR_LIB_DIR)/flexi_blas_common.c \
	$(TENSOR_LIB_DIR)/flexi_blas_scalar.c \
	$(TENSOR_LIB_DIR)/flexi_blas_vector.c \
	$(TENSOR_LIB_DIR)/flexi_blas_matrix.c \
	$(TENSOR_LIB_DIR)/flexi_tensor_common.c \
	$(TENSOR_LIB_DIR)/flexi_tensor_backend.c \
	$(TENSOR_LIB_DIR)/flexi_tensor_op.c
TENSOR_LIB_HEADERS := $(wildcard $(TENSOR_LIB_DIR)/*.h)
TENSOR_LIB_HOST_OBJECTS := $(patsubst $(TENSOR_LIB_DIR)/%.c,$(TENSOR_LIB_HOST_OBJ_DIR)/%.o,$(TENSOR_LIB_SOURCES))
TENSOR_LIB_RV_OBJECTS := $(patsubst $(TENSOR_LIB_DIR)/%.c,$(TENSOR_LIB_RV_OBJ_DIR)/%.o,$(TENSOR_LIB_SOURCES))
TENSOR_LIB_HOST_STATIC_OBJECTS := $(patsubst $(TENSOR_LIB_DIR)/%.c,$(TENSOR_LIB_HOST_STATIC_OBJ_DIR)/%.o,$(TENSOR_LIB_SOURCES))
TENSOR_LIB_RV_STATIC_OBJECTS := $(patsubst $(TENSOR_LIB_DIR)/%.c,$(TENSOR_LIB_RV_STATIC_OBJ_DIR)/%.o,$(TENSOR_LIB_SOURCES))

FLEXI_TENSOR_HOST_LIB := $(TENSOR_LIB_BUILD_DIR)/libflexi_tensor.a
FLEXI_TENSOR_RV_LIB := $(TENSOR_LIB_BUILD_DIR)/libflexi_tensor_rv.a
FLEXI_TENSOR_HOST_STATIC_LIB := $(TENSOR_LIB_BUILD_DIR)/libflexi_tensor_static.a
FLEXI_TENSOR_RV_STATIC_LIB := $(TENSOR_LIB_BUILD_DIR)/libflexi_tensor_rv_static.a
FLEXI_TENSOR_CFLAGS := -I$(CURDIR)/$(TENSOR_LIB_DIR)
FLEXI_TENSOR_LDFLAGS := -L$(CURDIR)/$(TENSOR_LIB_BUILD_DIR) -lflexi_tensor -lm
FLEXI_TENSOR_RV_CFLAGS := -I$(CURDIR)/$(TENSOR_LIB_DIR)
FLEXI_TENSOR_RV_LDFLAGS := -L$(CURDIR)/$(TENSOR_LIB_BUILD_DIR) -lflexi_tensor_rv -lm

TENSOR_LIB_HOST_CFLAGS := -std=c11 -O3 -Wall -Wextra -Werror -fPIC $(FLEXI_TENSOR_CFLAGS) -DFNBLAS_MEM_DYNAMIC_ENABLE=1
TENSOR_LIB_RV_CFLAGS := -std=c11 -O3 -Wall -Wextra -Werror -march=rv64gc -mabi=lp64d $(FLEXI_TENSOR_RV_CFLAGS) -DFNBLAS_MEM_DYNAMIC_ENABLE=1
TENSOR_LIB_HOST_STATIC_CFLAGS := -std=c11 -O3 -Wall -Wextra -Werror -fPIC $(FLEXI_TENSOR_CFLAGS) -DFNBLAS_MEM_DYNAMIC_ENABLE=0
TENSOR_LIB_RV_STATIC_CFLAGS := -std=c11 -O3 -Wall -Wextra -Werror -march=rv64gc -mabi=lp64d $(FLEXI_TENSOR_RV_CFLAGS) -DFNBLAS_MEM_DYNAMIC_ENABLE=0

.PHONY: tensor-libs tensor-lib-host tensor-lib-rv tensor-lib-host-static tensor-lib-rv-static tensor-lib-clean

tensor-libs: tensor-lib-host tensor-lib-rv tensor-lib-host-static tensor-lib-rv-static

tensor-lib-host: $(FLEXI_TENSOR_HOST_LIB)

tensor-lib-rv: $(FLEXI_TENSOR_RV_LIB)

tensor-lib-host-static: $(FLEXI_TENSOR_HOST_STATIC_LIB)

tensor-lib-rv-static: $(FLEXI_TENSOR_RV_STATIC_LIB)

$(FLEXI_TENSOR_HOST_LIB): $(TENSOR_LIB_HOST_OBJECTS) | $(TENSOR_LIB_BUILD_DIR)
	$(AR) rcs $@ $^

$(FLEXI_TENSOR_RV_LIB): $(TENSOR_LIB_RV_OBJECTS) | $(TENSOR_LIB_BUILD_DIR)
	$(AR_RV) rcs $@ $^

$(FLEXI_TENSOR_HOST_STATIC_LIB): $(TENSOR_LIB_HOST_STATIC_OBJECTS) | $(TENSOR_LIB_BUILD_DIR)
	$(AR) rcs $@ $^

$(FLEXI_TENSOR_RV_STATIC_LIB): $(TENSOR_LIB_RV_STATIC_OBJECTS) | $(TENSOR_LIB_BUILD_DIR)
	$(AR_RV) rcs $@ $^

$(TENSOR_LIB_HOST_OBJ_DIR)/%.o: $(TENSOR_LIB_DIR)/%.c $(TENSOR_LIB_HEADERS) | $(TENSOR_LIB_HOST_OBJ_DIR)
	$(CC) $(TENSOR_LIB_HOST_CFLAGS) -c $< -o $@

$(TENSOR_LIB_RV_OBJ_DIR)/%.o: $(TENSOR_LIB_DIR)/%.c $(TENSOR_LIB_HEADERS) | $(TENSOR_LIB_RV_OBJ_DIR)
	$(CC_RV) $(TENSOR_LIB_RV_CFLAGS) -c $< -o $@

$(TENSOR_LIB_HOST_STATIC_OBJ_DIR)/%.o: $(TENSOR_LIB_DIR)/%.c $(TENSOR_LIB_HEADERS) | $(TENSOR_LIB_HOST_STATIC_OBJ_DIR)
	$(CC) $(TENSOR_LIB_HOST_STATIC_CFLAGS) -c $< -o $@

$(TENSOR_LIB_RV_STATIC_OBJ_DIR)/%.o: $(TENSOR_LIB_DIR)/%.c $(TENSOR_LIB_HEADERS) | $(TENSOR_LIB_RV_STATIC_OBJ_DIR)
	$(CC_RV) $(TENSOR_LIB_RV_STATIC_CFLAGS) -c $< -o $@

$(TENSOR_LIB_BUILD_DIR) $(TENSOR_LIB_HOST_OBJ_DIR) $(TENSOR_LIB_RV_OBJ_DIR) $(TENSOR_LIB_HOST_STATIC_OBJ_DIR) $(TENSOR_LIB_RV_STATIC_OBJ_DIR):
	mkdir -p $@

tensor-lib-clean:
	rm -rf $(TENSOR_LIB_BUILD_DIR)
